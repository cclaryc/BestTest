# Copy this file to .env and change the value. .env is ignored by git.
#
# This is the password of the local development database. It never leaves your
# machine, but treat the habit as real: no password is ever committed.
POSTGRES_PASSWORD=change-me-local-only

# GitHub App (optional). Leave empty and everything except GitHub works.
#
# The client id is shown on your App's settings page on GitHub and looks like
# Iv23li... It is not a secret. The App's private key is: it goes in the file
# secrets/github-app.pem and nowhere else. See docs/milestones/04a.
BESTTEST_GITHUB_CLIENT_ID=

# Optional: a folder outside this project to keep the key in, for example
# C:/Users/you/.besttest (forward slashes work on Windows). The file inside
# must still be called github-app.pem.
# BESTTEST_SECRETS_DIR=
